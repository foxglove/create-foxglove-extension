{
  "name": "create-foxglove-extension",
  "version": "1.3.2",
  "publisher": "foxglove",
  "description": "Create and package Foxglove extensions",
  "license": "MIT",
  "keywords": [
    "foxglove",
    "robotics",
    "ros",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxglove/create-foxglove-extension.git"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./tsconfig/tsconfig.json": "./tsconfig/tsconfig.json",
    "./package.json": "./package.json",
    "./client": {
      "types": "./types/client.d.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "bin": {
    "create-foxglove-extension": "dist/bin/create-foxglove-extension.js",
    "foxglove-extension": "dist/bin/foxglove-extension.js"
  },
  "files": [
    "dist",
    "tsconfig",
    "types"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.testing.json && rimraf --glob \"dist/**/*.test.*\" && tar czf dist/template.tar.gz ./template",
    "lint": "vp check",
    "lint:ci": "vp check",
    "lint:fix": "vp check --fix",
    "prepack": "yarn build",
    "prepublishOnly": "yarn lint:ci && yarn test",
    "test": "vp test run",
    "watch": "tsc --watch"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@foxglove/extension": "^2"
  },
  "peerDependenciesMeta": {
    "@foxglove/extension": {
      "optional": true
    }
  },
  "devDependencies": {
    "@foxglove/extension": "2.59.0",
    "@foxglove/tsconfig": "2.0.0",
    "@types/ncp": "2.0.8",
    "@types/node": "22.9.0",
    "@types/node-fetch": "2.6.12",
    "@types/tmp": "0.2.6",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.64.0",
    "tmp": "0.2.7",
    "typescript": "5.6.3",
    "vite-plus": "1.1.0"
  },
  "dependencies": {
    "commander": "12.1.0",
    "jszip": "3.10.1",
    "mkdirp": "3.0.1",
    "ncp": "2.0.0",
    "node-fetch": "2.7.0",
    "path-browserify": "1.0.1",
    "rimraf": "6.1.2",
    "sanitize-filename": "1.6.3",
    "tar": "7.5.21"
  },
  "packageManager": "yarn@4.12.0"
}
